# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# whatsapp-web.js authentication and cache
.wwebjs_auth/
.wwebjs_cache/

# backend build
dist/

# turbo
.turbo/

# editors
.vscode/
.idea/
*.swp
*.swo

# logs
logs/
*.log

.baileys_auth/
.wa_session/


# build logs
*build_output.txt

# generated code from tsc
frontend/src/**/*.js
frontend/src/**/*.js.map
frontend/src/**/*.d.ts
backend/src/**/*.js
backend/src/**/*.js.map
backend/src/**/*.d.ts

# antigravity / gemini artifacts
.gemini/
.antigravity/
.antigravityignore

# Large storage & local binaries
.mongodb-binaries/
backups/
temp/
*.log
